#!/bin/bash
# agent-cage: run a command (Claude Code, Codex, anything) under a macOS seatbelt profile
# that denies every file write except the folders you allow.
#
# The kernel enforces the profile, so it holds no matter what the agent's own permission
# settings, allowlists or hooks say. Reads and network stay open unless you close them.
set -euo pipefail

VERSION="0.1.0"
SANDBOX_EXEC="${AGENT_CAGE_SANDBOX_EXEC:-/usr/bin/sandbox-exec}"

usage() {
  cat <<'EOF'
agent-cage: run an AI agent read-only, or able to write only in folders you name (macOS).

usage: agent-cage [options] [--] <command> [args...]

  -w, --write DIR    also allow writes inside DIR (repeatable; created if missing)
  -n, --no-net       block network (local unix sockets still work)
      --no-state     do not allow writes to agent state dirs (~/.claude, ~/.codex, caches)
      --print        print the generated profile and exit
      --selftest     prove the cage works on this machine and exit
  -h, --help         this help
  -V, --version      print the version

examples:
  agent-cage claude -p "review this repo"            # read-only
  agent-cage -w ./out claude -p "write a report"     # may write only in ./out
  agent-cage -w . codex exec "fix the failing test"  # may write only in this repo

env: AGENT_CAGE_WRITE=dir1:dir2  extra writable dirs (same as -w)
     AGENT_CAGE_STATE=dir1:dir2  replace the default agent state dirs
EOF
}

die() { echo "agent-cage: $*" >&2; exit 2; }

# absolute, symlink-free path of an existing directory (the kernel checks real paths)
real_dir() { (cd "$1" 2>/dev/null && pwd -P) || die "not a directory: $1"; }

# quote a path for an SBPL string literal
sb_str() { local s="${1//\\/\\\\}"; s="${s//\"/\\\"}"; printf '"%s"' "$s"; }

# escape a path for an SBPL regex literal
sb_re() { printf '%s' "$1" | sed -e 's/[][\\.^$*+?(){}|]/\\&/g' -e 's/"/\\"/g'; }

WRITE_DIRS=()
NO_NET=0
NO_STATE=0
MODE=run

while [ $# -gt 0 ]; do
  case "$1" in
    -w|--write) [ $# -ge 2 ] || die "$1 needs a directory"; WRITE_DIRS+=("$2"); shift 2 ;;
    --write=*) WRITE_DIRS+=("${1#*=}"); shift ;;
    -n|--no-net) NO_NET=1; shift ;;
    --no-state) NO_STATE=1; shift ;;
    --print) MODE=print; shift ;;
    --selftest) MODE=selftest; shift ;;
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "agent-cage $VERSION"; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown option: $1 (see agent-cage --help)" ;;
    *) break ;;
  esac
done

if [ -n "${AGENT_CAGE_WRITE:-}" ]; then
  IFS=: read -r -a _extra <<<"$AGENT_CAGE_WRITE"
  for d in "${_extra[@]}"; do [ -n "$d" ] && WRITE_DIRS+=("$d"); done
fi

[ "$(uname -s)" = "Darwin" ] || die "macOS only (needs sandbox-exec)"
[ -x "$SANDBOX_EXEC" ] || die "sandbox-exec not found at $SANDBOX_EXEC"

HOME_REAL="$(real_dir "$HOME")"

build_profile() {
  local d
  echo ";; generated by agent-cage $VERSION"
  echo "(version 1)"
  echo "(allow default)"
  echo "(deny file-write*)"
  echo "(allow file-write*"
  # devices and temp space every process needs
  echo "  (subpath \"/dev\")"
  echo "  (subpath \"/private/var/folders\")"
  echo "  (subpath \"/private/tmp\")"
  if [ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ]; then
    echo "  (subpath $(sb_str "$(real_dir "$TMPDIR")"))"
  fi
  if [ "$NO_STATE" = 0 ]; then
    # the agent's own session state, so it can start, log in and keep history
    if [ -n "${AGENT_CAGE_STATE:-}" ]; then
      local _state; IFS=: read -r -a _state <<<"$AGENT_CAGE_STATE"
      for d in "${_state[@]}"; do
        [ -n "$d" ] || continue; mkdir -p "$d"; echo "  (subpath $(sb_str "$(real_dir "$d")"))"
      done
    else
      echo "  (subpath $(sb_str "$HOME_REAL/.claude"))"
      echo "  (regex #\"^$(sb_re "$HOME_REAL")/\\.claude\\.json\")"
      echo "  (subpath $(sb_str "$HOME_REAL/.codex"))"
      echo "  (subpath $(sb_str "$HOME_REAL/.cache"))"
      echo "  (subpath $(sb_str "$HOME_REAL/Library/Caches"))"
    fi
  fi
  for d in ${WRITE_DIRS[@]+"${WRITE_DIRS[@]}"}; do
    mkdir -p "$d"
    echo "  (subpath $(sb_str "$(real_dir "$d")"))"
  done
  echo ")"
  if [ "$NO_STATE" = 0 ] && [ -z "${AGENT_CAGE_STATE:-}" ]; then
    # state dirs stay writable, but not the files that would let the agent change its own
    # rules or run code outside the cage in a later session
    echo "(deny file-write*"
    for f in settings.json settings.local.json CLAUDE.md; do
      echo "  (literal $(sb_str "$HOME_REAL/.claude/$f"))"
    done
    echo "  (subpath $(sb_str "$HOME_REAL/.claude/hooks"))"
    echo "  (literal $(sb_str "$HOME_REAL/.codex/config.toml"))"
    echo "  (literal $(sb_str "$HOME_REAL/.codex/AGENTS.md"))"
    echo ")"
  fi
  if [ "$NO_NET" = 1 ]; then
    echo "(deny network*)"
    echo "(allow network* (remote unix-socket))"
  fi
}

selftest() {
  local t out ok=1
  # probe folder in $HOME: temp dirs are writable inside the cage on purpose
  t="$(mktemp -d "$HOME_REAL/.agent-cage-selftest.XXXXXX")"
  mkdir -p "$t/outside"
  WRITE_DIRS+=("$t/allowed")
  local prof; prof="$(build_profile)"
  try() { # label, expect (ok|denied), command
    local label="$1" want="$2"; shift 2
    if "$SANDBOX_EXEC" -p "$prof" /bin/sh -c "$*" >/dev/null 2>&1; then got=ok; else got=denied; fi
    if [ "$got" = "$want" ]; then echo "  pass  $label ($got)"; else echo "  FAIL  $label (wanted $want, got $got)"; ok=0; fi
  }
  echo "agent-cage selftest"
  try "write outside allowed dirs" denied "echo x > '$t/outside/f'"
  try "write in home folder"       denied "echo x > '$HOME_REAL/.agent-cage-probe'"
  try "write in -w dir"            ok     "echo x > '$t/allowed/f'"
  try "read a file"                ok     "cat /etc/hosts"
  try "delete outside allowed"     denied "rmdir '$t/outside'"
  rm -f "$HOME_REAL/.agent-cage-probe" 2>/dev/null || true
  rm -rf "$t"
  if [ "$ok" = 1 ]; then echo "cage works"; return 0; fi
  echo "cage NOT working on this machine"; return 1
}

case "$MODE" in
  print) build_profile; exit 0 ;;
  selftest) selftest; exit $? ;;
esac

[ $# -gt 0 ] || { usage >&2; exit 2; }
PROFILE="$(build_profile)"
if [ -n "${AGENT_CAGE_DEBUG:-}" ]; then echo "$PROFILE" >&2; fi
exec "$SANDBOX_EXEC" -p "$PROFILE" "$@"
